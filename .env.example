# URL da API usada pelo frontend.
# /api usa o proxy do Vite e funciona pelo IP da máquina em celulares.
VITE_API_BASE_URL=/api
# Destino do proxy local do Vite
API_PROXY_TARGET=http://127.0.0.1:3000

# Configuração do servidor MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trilha_aprender
DB_PASSWORD=coloque_sua_senha_aqui
DB_NAME=trilha_aprender

# Configuração da API
PORT=3000
FRONTEND_URL=http://localhost:5173
# Permite frontend acessado por IP privado (192.168.x.x, 10.x.x.x etc.)
ALLOW_LAN_ORIGINS=true
